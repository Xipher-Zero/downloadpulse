@@ -448,6 +448,17 @@ router::Response serve(string path, const fs::FileReaderOptions &fileReaderOptio
     // Ignore query params
     path = path.substr(0, path.find("?"));
 
+    // DownloadPulse: only a path inside the document root is served -- no
+    // ".." segment (encoded or not, it is decoded above), no backslash.
+    string root = neuserver::getDocumentRoot() + "/";
+    bool inside = path.compare(0, root.size(), root) == 0 && path.find('\\') == string::npos;
+    for(const string &segment: helpers::split(path, '/')) {
+        inside = inside && segment != "..";
+    }
+    if(!inside) {
+        return router::Response {websocketpp::http::status_code::forbidden, "text/plain", ""};
+    }
