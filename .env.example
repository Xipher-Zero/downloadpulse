# DownloadPulse — environment variables
# Copy to .env beside docker-compose.yml (cp .env.example .env); Docker Compose
# fills docker-compose.yml's ${NAME} values from it. Every value is optional:
# without one, the default shown applies.

# Timezone
TZ=Etc/UTC

# The user and group that own your downloads and DownloadPulse's own files
# (`id -u` and `id -g` on the host; Unraid: 99 and 100).
PUID=1000
PGID=1000

# Optional canonical externally reachable HTTPS origin.
# Recommended when DownloadPulse is exposed through a reverse proxy.
# Used for browser origin validation, secure-cookie classification, and OIDC callbacks.
# This environment value overrides the persisted Authentication-menu value.
# PUBLIC_BASE_URL=https://download.example.com
